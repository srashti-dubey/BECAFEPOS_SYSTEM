VITE_APP_NAME=my-react-app
# Relative URL — browser hits the nginx proxy on the same host/port as the SPA.
VITE_API_BASE_URL=/api/v1
# Real backend origin (no /api suffix). Used only by nginx at container runtime.
API_UPSTREAM=http://10.3.33.31:3000
VITE_API_KEY=
VITE_ENCRYPT_DECRYPT_KEY=
VITE_USE_MOCK_API=false
